# 실제 백엔드 기준 URL. 예: https://backend.example.com/api/
VITE_API_BASE_URL=/api/
VITE_API_TIMEOUT_MS=10000
# 로컬 /api 요청을 전달할 백엔드. Vite 개발 서버에서만 사용합니다.
API_PROXY_TARGET=http://localhost:8080
# Kakao Developers의 JavaScript 키. .env.local에 실제 값을 설정합니다.
# SDK 도메인에 http://127.0.0.1:5173 및 배포 도메인을 등록해야 합니다.
VITE_KAKAO_MAP_APP_KEY=
# DEV: 더미 데이터와 우측 상단 DEV 표시 / PRD: 백엔드 조회
VITE_APP_ENV=DEV
